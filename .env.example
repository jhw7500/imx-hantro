# 호스트별 빌드 경로. 이 파일을 .env 로 복사해 채운다 — .env 는 커밋되지 않는다.
#
#   cp .env.example .env
#
# 한 줄에 KEY=VALUE 하나. 따옴표와 공백 없이 쓴다 (Makefile 과 셸이 함께 읽는다).
# make 가 이 파일을 makefile 소스로 읽으므로 아래 키 말고 다른 줄은 넣지 않는다.

# Yocto SDK 설치 위치. ${SDK_LOC}/environment-setup-${SDK_NAME} 이 있어야 한다.
SDK_LOC=
SDK_NAME=cortexa53-crypto-poky-linux

# 커널 소스 트리 — 보드 커널(uname -r)과 같은 kernel.release 로 빌드된 트리여야 한다.
KERNEL_SRC=

# 소스와 빌드가 나뉜 트리에서만 채운다 — .config 와 include/config/kernel.release 가 있는 쪽.
KBUILD_OUTPUT=

# pim-package 저장소 위치 (비우면 이 저장소와 나란히 있는 ../pim-package-jhw).
PIM_PACKAGE_DIR=
